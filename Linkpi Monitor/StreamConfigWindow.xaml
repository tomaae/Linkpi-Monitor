<Window x:Class="Linkpi_Monitor.StreamConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stream configuration" Width="620" Height="570" MinWidth="520" MinHeight="480"
        Background="{StaticResource WindowBrush}" WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding Name}" FontSize="25" FontWeight="SemiBold" />
                <TextBlock Text="{Binding SourceType}" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Background="#27313D" CornerRadius="12" Padding="10,5" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Status}" Margin="7,0,0,0" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1" Background="#241F12" BorderBrush="#5B4818" BorderThickness="1" CornerRadius="7"
                Padding="12" Margin="0,20,0,14">
            <TextBlock Text="Read-only view. Editing controls are shown for layout planning but remain disabled."
                       Foreground="#FFD978" TextWrapping="Wrap" />
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="SOURCE" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="SemiBold" />
                <TextBox Text="{Binding SourceType}" IsReadOnly="True" Margin="0,5,0,14" Padding="10,8" />
                <TextBlock Text="VIDEO ENCODER" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="SemiBold" />
                <TextBox Text="{Binding VideoSummary}" IsReadOnly="True" Margin="0,5,0,14" Padding="10,8" />
                <TextBlock Text="AUDIO ENCODER" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="SemiBold" />
                <TextBox Text="{Binding AudioSummary}" IsReadOnly="True" Margin="0,5,0,14" Padding="10,8" />
                <TextBlock Text="STREAM OUTPUTS" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="SemiBold" />
                <TextBox Text="{Binding OutputsSummary}" IsReadOnly="True" Margin="0,5,0,14" Padding="10,8" />
                <TextBlock Text="WATCH URL" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="SemiBold" />
                <TextBox Text="{Binding WatchUri}" IsReadOnly="True" Margin="0,5,0,14" Padding="10,8" />
                <CheckBox Content="Channel enabled" IsChecked="{Binding IsEnabled}" IsEnabled="False" Foreground="{StaticResource TextBrush}" />
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="3" Margin="0,18,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Button Grid.Column="1" Content="Enable editing" IsEnabled="False" ToolTip="Configuration editing is not implemented yet." />
            <Button Grid.Column="3" Content="Close" Style="{StaticResource PrimaryButton}" Click="CloseButton_Click" />
        </Grid>
    </Grid>
</Window>
