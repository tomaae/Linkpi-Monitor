<Window x:Class="Linkpi_Monitor.DeviceEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Device" Icon="App.ico" Width="520" Height="535" MinWidth="520" MinHeight="535"
        Background="{StaticResource WindowBrush}" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="DeviceFieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style x:Key="DeviceTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="#11161C" />
            <Setter Property="Background" Value="#F2F5F7" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock x:Name="HeadingText" Text="Add device" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Stored only in the local, git-excluded config.json. This does not modify the LinkPi device."
                       Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="DISPLAY NAME" Style="{StaticResource DeviceFieldLabel}" />
            <TextBox x:Name="NameTextBox" Style="{StaticResource DeviceTextBox}" />
        </StackPanel>
        <StackPanel Grid.Row="2">
            <TextBlock Text="BASE URL" Style="{StaticResource DeviceFieldLabel}" />
            <TextBox x:Name="BaseUrlTextBox" Style="{StaticResource DeviceTextBox}"
                     ToolTip="For example: http://192.168.1.100" />
        </StackPanel>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="USERNAME" Style="{StaticResource DeviceFieldLabel}" />
                <TextBox x:Name="UsernameTextBox" Style="{StaticResource DeviceTextBox}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="PASSWORD" Style="{StaticResource DeviceFieldLabel}" />
                <PasswordBox x:Name="PasswordInput" Foreground="#11161C" Background="#F2F5F7"
                             Padding="10,7" MinHeight="36" Margin="0,0,0,14" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,14">
            <StackPanel>
                <CheckBox x:Name="AllowChangesCheckBox" Content="Allow configuration changes on this device"
                          Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" />
                <TextBlock Text="Keep this off for monitoring-only devices. Enable it only when configuration writes are intended."
                           Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="22,5,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Row="5" x:Name="ValidationBorder" Background="#3A1F24" BorderBrush="#84404C"
                BorderThickness="1" CornerRadius="6" Padding="10" Visibility="Collapsed">
            <TextBlock x:Name="ValidationText" Foreground="#FFB4BE" TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="7" Margin="0,20,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Button Grid.Column="1" Content="Cancel" IsCancel="True" />
            <Button Grid.Column="3" Content="Save device" Style="{StaticResource PrimaryButton}"
                    IsDefault="True" Click="SaveButton_Click" />
        </Grid>
    </Grid>
</Window>
