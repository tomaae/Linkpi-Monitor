<Window x:Class="Linkpi_Monitor.WatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="Watch stream" Icon="App.ico" Width="1060" Height="680" MinWidth="560" MinHeight="400"
        Background="{StaticResource WindowBrush}" WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded" Closed="Window_Closed">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#121920" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="ChannelNameText" FontSize="19" FontWeight="SemiBold" />
                    <TextBlock x:Name="StreamAddressText" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="PlaybackStatusDot" Width="8" Height="8" Fill="#F5B82E" />
                    <TextBlock x:Name="PlaybackStatusText" Text="Opening stream" Margin="7,0,0,0" />
                    <Button x:Name="MuteButton" Content="Mute" Width="82" Margin="18,0,0,0" Padding="12,7"
                            Click="MuteButton_Click" ToolTip="Mute this live view" />
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="VideoHost" Grid.Row="1" Background="Black" SizeChanged="VideoHost_SizeChanged">
            <vlc:VideoView x:Name="VideoView" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
    </Grid>
</Window>
