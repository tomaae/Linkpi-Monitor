<UserControl x:Class="Linkpi_Monitor.HardwareEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style x:Key="ConfigTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="MinHeight" Value="35" />
        </Style>
        <Style x:Key="ConfigComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="MinHeight" Value="35" />
        </Style>
        <Style x:Key="ConfigCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Margin" Value="0,7,18,10" />
        </Style>
        <Style x:Key="ConfigCard" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <DataTemplate x:Key="AudioInputTemplate">
            <StackPanel>
                <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Device}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,3,0,14" />
                <UniformGrid Columns="3">
                    <StackPanel><TextBlock Text="NOISE REDUCTION" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding NoiseReductionModes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding NoiseReduction}" Style="{StaticResource ConfigComboBox}" /></StackPanel>
                    <StackPanel><TextBlock Text="NOISE REDUCTION LEVEL" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding NoiseReductionLevels}" IsEditable="True" Text="{Binding NoiseReductionLevel}" Style="{StaticResource ConfigComboBox}" /></StackPanel>
                    <StackPanel><TextBlock Text="GAIN" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding Gains}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Gain}" Style="{StaticResource ConfigComboBox}" /></StackPanel>
                </UniformGrid>
                <CheckBox Content="Input enabled" IsChecked="{Binding Enabled}" Style="{StaticResource ConfigCheckBox}" Visibility="{Binding EnabledVisibility}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="VideoOutputTemplate">
            <Border Style="{StaticResource ConfigCard}"><StackPanel>
                <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="Physical display output. Availability and formats follow the device capability report." Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,3,0,14" />
                <WrapPanel>
                    <CheckBox Content="Output enabled" IsChecked="{Binding Enabled}" Style="{StaticResource ConfigCheckBox}" />
                    <CheckBox Content="Low latency" IsChecked="{Binding LowLatency}" Style="{StaticResource ConfigCheckBox}" />
                    <CheckBox Content="Mirror" IsChecked="{Binding Mirror}" Style="{StaticResource ConfigCheckBox}" />
                </WrapPanel>
                <UniformGrid Columns="3">
                    <StackPanel><TextBlock Text="OUTPUT TYPE" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding Types}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Type}" Style="{StaticResource ConfigComboBox}" /></StackPanel>
                    <StackPanel><TextBlock Text="FORMAT" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding Resolutions}" IsEditable="True" Text="{Binding Resolution}" Style="{StaticResource ConfigComboBox}" /></StackPanel>
                    <StackPanel><TextBlock Text="SOURCE" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding Sources}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Source}" Style="{StaticResource ConfigComboBox}" /></StackPanel>
                    <StackPanel><TextBlock Text="ROTATE" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding Rotations}" SelectedItem="{Binding Rotate}" Style="{StaticResource ConfigComboBox}" /></StackPanel>
                    <StackPanel><TextBlock Text="COLOR MATRIX" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding ColorMatrices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding ColorMatrix}" Style="{StaticResource ConfigComboBox}" /></StackPanel>
                </UniformGrid>
                <Expander Margin="0,4,0,0">
                    <Expander.Header><TextBlock Text="Color adjustment" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" /></Expander.Header>
                    <UniformGrid Columns="4" Margin="0,12,0,0">
                        <StackPanel><TextBlock Text="LUMA" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Luma}" Style="{StaticResource ConfigTextBox}" /></StackPanel>
                        <StackPanel><TextBlock Text="CONTRAST" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Contrast}" Style="{StaticResource ConfigTextBox}" /></StackPanel>
                        <StackPanel><TextBlock Text="SATURATION" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Saturation}" Style="{StaticResource ConfigTextBox}" /></StackPanel>
                        <StackPanel><TextBlock Text="HUE" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Hue}" Style="{StaticResource ConfigTextBox}" /></StackPanel>
                    </UniformGrid>
                </Expander>
            </StackPanel></Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="6,14,6,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="2,0,2,14">
            <TextBlock Text="Hardware" FontSize="25" FontWeight="SemiBold" />
            <TextBlock Text="Physical audio and display interfaces reported by this LinkPi model." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
            <StackPanel Visibility="{Binding UsbAudioVisibility}">
                <TextBlock Text="Audio input" FontSize="20" FontWeight="SemiBold" Margin="2,0,0,10" />
                <Border Style="{StaticResource ConfigCard}"><ContentControl Content="{Binding UsbAudioInput}" ContentTemplate="{StaticResource AudioInputTemplate}" /></Border>
            </StackPanel>
            <StackPanel Visibility="{Binding LineAudioVisibility}">
                <Border Style="{StaticResource ConfigCard}"><ContentControl Content="{Binding LineAudioInput}" ContentTemplate="{StaticResource AudioInputTemplate}" /></Border>
                <TextBlock Text="Audio output" FontSize="20" FontWeight="SemiBold" Margin="2,2,0,10" />
                <Border Style="{StaticResource ConfigCard}"><StackPanel>
                    <TextBlock Text="Line output" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Analog audio-jack output routing." Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,3,0,14" />
                    <UniformGrid Columns="2">
                        <StackPanel><TextBlock Text="SOURCE" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding LineAudioOutput.Sources}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding LineAudioOutput.Source}" Style="{StaticResource ConfigComboBox}" /></StackPanel>
                        <StackPanel><TextBlock Text="GAIN" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding LineAudioOutput.Gains}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding LineAudioOutput.Gain}" Style="{StaticResource ConfigComboBox}" /></StackPanel>
                    </UniformGrid>
                </StackPanel></Border>
            </StackPanel>
            <StackPanel Visibility="{Binding VideoOutputVisibility}">
                <TextBlock Text="Video output" FontSize="20" FontWeight="SemiBold" Margin="2,2,0,10" />
                <ItemsControl ItemsSource="{Binding VideoOutputs}" ItemTemplate="{StaticResource VideoOutputTemplate}" />
            </StackPanel>
        </StackPanel></ScrollViewer>
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="Controls are live UI previews only; no settings are sent to the device." Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Save changes" IsEnabled="False" ToolTip="Saving configuration is not implemented yet." />
        </Grid>
    </Grid>
</UserControl>
