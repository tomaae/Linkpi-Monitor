<Window x:Class="Linkpi_Monitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Linkpi_Monitor"
        mc:Ignorable="d"
        Title="LinkPi Monitor" Icon="App.ico" Height="820" Width="1280" MinWidth="980" MinHeight="640"
        Background="{StaticResource WindowBrush}" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closed="Window_Closed">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#121920" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/AppIcon.png" Width="40" Height="40" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="LinkPi Monitor" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="Read-only device overview" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="DEVICE" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="SemiBold" />
                        <ComboBox x:Name="DevicePicker" Width="230" Margin="0,3,0,0" ItemsSource="{Binding Devices}"
                                  SelectionChanged="DevicePicker_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Foreground="#11161C" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <Button Content="Add device" IsEnabled="False" Margin="0,18,8,0"
                            ToolTip="Device editing is planned but not implemented yet." />
                    <Button Content="Refresh" Style="{StaticResource PrimaryButton}" Margin="0,18,0,0"
                            Click="RefreshButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#241F12" BorderBrush="#5B4818" BorderThickness="0,0,0,1"
                    Padding="24,10" Visibility="{Binding ErrorVisibility}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFD978" TextWrapping="Wrap" />
            </Border>
            <Grid Grid.Row="1" Margin="24,20,24,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="18,14">
                    <StackPanel>
                        <TextBlock Text="CONNECTION" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Ellipse Width="9" Height="9" Fill="{Binding ConnectionBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ConnectionStatus}" FontSize="20" FontWeight="SemiBold" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="18,14">
                    <StackPanel><TextBlock Text="CPU" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding CpuDisplay}" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0" /></StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="18,14">
                    <StackPanel><TextBlock Text="MEMORY" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding MemoryDisplay}" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0" /></StackPanel>
                </Border>
                <Border Grid.Column="6" Style="{StaticResource CardStyle}" Padding="18,14">
                    <StackPanel><TextBlock Text="TEMPERATURE" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding TemperatureDisplay}" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0" /></StackPanel>
                </Border>
            </Grid>

            <TabControl Grid.Row="2" Margin="18,0,18,18" Background="Transparent" BorderThickness="0">
                <TabItem Header="Sources &amp; Streams">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="6,14,6,20">
                            <Grid Margin="2,0,2,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Sources &amp; streams" FontSize="25" FontWeight="SemiBold" />
                                    <TextBlock Text="Decode, encode and output status are grouped per source. HDMI, USB camera and Mix remain first-class channels."
                                               Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Edit channel order" IsEnabled="False" VerticalAlignment="Center"
                                        ToolTip="Channel editing is not implemented yet." />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Channels}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardStyle}" Width="365" Margin="0,0,14,14" Padding="0">
                                            <StackPanel>
                                                <Border Height="170" Background="#090D12" CornerRadius="9,9,0,0">
                                                    <Grid>
                                                        <TextBlock Text="{Binding Initial}" Foreground="#24303C" FontSize="68" FontWeight="Bold"
                                                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <Image Source="{Binding PreviewImage}" Stretch="Fill"
                                                               Width="{Binding PreviewRenderWidth}" Height="{Binding PreviewRenderHeight}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <Border VerticalAlignment="Bottom" Background="#CC11171E" Padding="12,9">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasPreview}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding PreviewMessage}" Foreground="{StaticResource MutedTextBrush}"
                                                                       FontSize="11" HorizontalAlignment="Center" />
                                                        </Border>
                                                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Padding="8,4"
                                                                CornerRadius="10" Background="#D91B232D">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding Status}" Margin="6,0,0,0" FontSize="11" FontWeight="SemiBold" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Margin="16,14,16,16">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <StackPanel><TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding SourceType}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,2,0,0" /></StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding Id, StringFormat=CH {0}}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" VerticalAlignment="Top" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding VideoSummary}" Margin="0,13,0,0" FontSize="12" />
                                                    <TextBlock Text="{Binding AudioSummary}" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" FontSize="12" />
                                                    <TextBlock Text="{Binding OutputsSummary}" Foreground="{StaticResource AccentBrush}" Margin="0,8,0,0" FontSize="11" />
                                                    <Grid Margin="0,14,0,0">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                        <Button Grid.Column="0" Content="Watch" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding CanWatch}"
                                                                Tag="{Binding}" Click="WatchButton_Click" ToolTip="Open the live stream inside LinkPi Monitor." />
                                                        <Button Grid.Column="2" Content="Configuration" Tag="{Binding}" Click="ConfigurationButton_Click"
                                                                ToolTip="Open the configuration preview. Saving remains disabled." />
                                                    </Grid>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Push">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="6,14,6,20">
                            <Grid Margin="2,0,2,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Push destinations" FontSize="25" FontWeight="SemiBold" />
                                    <TextBlock Text="Configured publishing targets and their current transfer state. Publishing paths are deliberately hidden."
                                               Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Add destination" IsEnabled="False" Margin="0,0,8,0" ToolTip="Push editing is not implemented yet." />
                                    <Button Content="Start all" IsEnabled="False" Margin="0,0,8,0" ToolTip="Push control is not implemented yet." />
                                    <Button Content="Stop all" IsEnabled="False" ToolTip="Push control is not implemented yet." />
                                </StackPanel>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding PushDestinations}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10" Padding="18">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="1.4*" />
                                                    <ColumnDefinition Width="1.4*" /><ColumnDefinition Width="1.1*" />
                                                    <ColumnDefinition Width="1.1*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0"><TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Destination}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,3,0,0" /></StackPanel>
                                                <StackPanel Grid.Column="1"><TextBlock Text="SOURCE" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                                                    <TextBlock Text="{Binding Source}" Margin="0,4,0,0" /></StackPanel>
                                                <StackPanel Grid.Column="2"><TextBlock Text="STATUS" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0"><Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Status}" Margin="7,0,0,0" /></StackPanel></StackPanel>
                                                <StackPanel Grid.Column="3"><TextBlock Text="RATE" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                                                    <TextBlock Text="{Binding Speed}" Margin="0,4,0,0" /></StackPanel>
                                                <StackPanel Grid.Column="4"><TextBlock Text="DURATION" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                                                    <TextBlock Text="{Binding Duration}" Margin="0,4,0,0" /></StackPanel>
                                                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="Edit" IsEnabled="False" Margin="0,0,8,0" ToolTip="Push editing is not implemented yet." />
                                                    <Button Content="Start / Stop" IsEnabled="False" ToolTip="Push control is not implemented yet." />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
