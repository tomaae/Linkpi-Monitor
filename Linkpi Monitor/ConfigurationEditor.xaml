<UserControl x:Class="Linkpi_Monitor.ConfigurationEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style x:Key="ConfigTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="MinHeight" Value="35" />
        </Style>
        <Style x:Key="ConfigComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="MinHeight" Value="35" />
        </Style>
        <Style x:Key="ConfigCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Margin" Value="0,7,18,10" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ConfigCard" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <DataTemplate x:Key="EncoderTemplate">
            <StackPanel>
                <WrapPanel Margin="0,0,0,4">
                    <CheckBox Content="Enabled" IsChecked="{Binding Enabled}" Style="{StaticResource ConfigCheckBox}" />
                    <CheckBox Content="Low latency" IsChecked="{Binding LowLatency}" Style="{StaticResource ConfigCheckBox}" />
                </WrapPanel>
                <UniformGrid Columns="2">
                    <StackPanel><TextBlock Text="VIDEO SIZE" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding VideoSizes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding VideoSize}" Style="{StaticResource ConfigComboBox}" /></StackPanel>
                    <StackPanel><TextBlock Text="CODEC / PROFILE" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding VideoFormats}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding VideoFormat}" Style="{StaticResource ConfigComboBox}" /></StackPanel>
                    <StackPanel><TextBlock Text="RATE CONTROL" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding RateControls}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding RateControl}" Style="{StaticResource ConfigComboBox}" /></StackPanel>
                    <StackPanel><TextBlock Text="BITRATE (KB/S)" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding Bitrates}" IsEditable="True" Text="{Binding Bitrate}" Style="{StaticResource ConfigComboBox}" /></StackPanel>
                    <StackPanel><TextBlock Text="FRAMERATE (-1 = SOURCE)" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding Framerates}" IsEditable="True" Text="{Binding Framerate}" Style="{StaticResource ConfigComboBox}" /></StackPanel>
                    <StackPanel><TextBlock Text="GOP (SECONDS)" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding Gops}" IsEditable="True" Text="{Binding Gop}" Style="{StaticResource ConfigComboBox}" /></StackPanel>
                </UniformGrid>
                <Expander Margin="0,4,0,0">
                    <Expander.Header><TextBlock Text="Advanced video encoding" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" /></Expander.Header>
                    <UniformGrid Columns="3" Margin="0,12,0,0">
                        <StackPanel><TextBlock Text="GOP MODE" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding GopModes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding GopMode}" Style="{StaticResource ConfigComboBox}" /></StackPanel>
                        <StackPanel><TextBlock Text="MIN QP" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding MinimumQp}" Style="{StaticResource ConfigTextBox}" /></StackPanel>
                        <StackPanel><TextBlock Text="MAX QP" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding MaximumQp}" Style="{StaticResource ConfigTextBox}" /></StackPanel>
                        <StackPanel><TextBlock Text="FIXED I QP" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding FixedIQp}" Style="{StaticResource ConfigTextBox}" /></StackPanel>
                        <StackPanel><TextBlock Text="FIXED P QP" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding FixedPQp}" Style="{StaticResource ConfigTextBox}" /></StackPanel>
                        <StackPanel><TextBlock Text="TIMESTAMP SYNC" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding TimestampModes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding TimestampMode}" Style="{StaticResource ConfigComboBox}" /></StackPanel>
                    </UniformGrid>
                </Expander>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="StreamOutputTemplate">
            <StackPanel>
                <TextBlock Text="PROTOCOLS" Style="{StaticResource FieldLabel}" />
                <WrapPanel Margin="0,0,0,6">
                    <CheckBox Content="HTTP" IsChecked="{Binding Http}" Style="{StaticResource ConfigCheckBox}" />
                    <CheckBox Content="HLS" IsChecked="{Binding Hls}" Style="{StaticResource ConfigCheckBox}" />
                    <CheckBox Content="RTMP" IsChecked="{Binding Rtmp}" Style="{StaticResource ConfigCheckBox}" />
                    <CheckBox Content="RTSP" IsChecked="{Binding Rtsp.Enabled}" Style="{StaticResource ConfigCheckBox}" />
                    <CheckBox Content="WebRTC" IsChecked="{Binding WebRtc}" Style="{StaticResource ConfigCheckBox}" />
                    <CheckBox Content="SRT" IsChecked="{Binding Srt.Enabled}" Style="{StaticResource ConfigCheckBox}" />
                    <CheckBox Content="RIST" IsChecked="{Binding Rist.Enabled}" Style="{StaticResource ConfigCheckBox}" />
                    <CheckBox Content="UDP" IsChecked="{Binding Udp.Enabled}" Style="{StaticResource ConfigCheckBox}" />
                    <CheckBox Content="Push" IsChecked="{Binding Push.Enabled}" Style="{StaticResource ConfigCheckBox}" />
                </WrapPanel>
                <TextBlock Text="STREAM SUFFIX" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Suffix}" Style="{StaticResource ConfigTextBox}" />

                <Expander Margin="0,4,0,0">
                    <Expander.Header><TextBlock Text="RTSP" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" /></Expander.Header>
                    <UniformGrid Columns="2" Margin="0,12,0,0">
                        <StackPanel><TextBlock Text="USERNAME" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Rtsp.Username}" Style="{StaticResource ConfigTextBox}" /></StackPanel>
                        <StackPanel><TextBlock Text="PASSWORD" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Rtsp.Password}" Style="{StaticResource ConfigTextBox}" /></StackPanel>
                        <CheckBox Content="Require authentication" IsChecked="{Binding Rtsp.Authentication}" Style="{StaticResource ConfigCheckBox}" />
                        <CheckBox Content="Advertise through ONVIF" IsChecked="{Binding Rtsp.Onvif}" Style="{StaticResource ConfigCheckBox}" />
                    </UniformGrid>
                </Expander>
                <Expander Margin="0,10,0,0">
                    <Expander.Header><TextBlock Text="SRT" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" /></Expander.Header>
                    <UniformGrid Columns="2" Margin="0,12,0,0">
                        <StackPanel><TextBlock Text="MODE" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding Srt.Modes}" SelectedItem="{Binding Srt.Mode}" Style="{StaticResource ConfigComboBox}" /></StackPanel>
                        <StackPanel><TextBlock Text="IP ADDRESS" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Srt.IpAddress}" Style="{StaticResource ConfigTextBox}" /></StackPanel>
                        <StackPanel><TextBlock Text="STREAM ID" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Srt.StreamId}" Style="{StaticResource ConfigTextBox}" /></StackPanel>
                        <StackPanel><TextBlock Text="PORT" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Srt.Port}" Style="{StaticResource ConfigTextBox}" /></StackPanel>
                        <StackPanel><TextBlock Text="LATENCY (MS)" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Srt.Latency}" Style="{StaticResource ConfigTextBox}" /></StackPanel>
                        <StackPanel><TextBlock Text="PASSWORD" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Srt.Password}" Style="{StaticResource ConfigTextBox}" /></StackPanel>
                    </UniformGrid>
                </Expander>
                <Expander Margin="0,10,0,0">
                    <Expander.Header><TextBlock Text="UDP / RTP" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" /></Expander.Header>
                    <UniformGrid Columns="2" Margin="0,12,0,0">
                        <StackPanel><TextBlock Text="IP ADDRESS" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Udp.IpAddress}" Style="{StaticResource ConfigTextBox}" /></StackPanel>
                        <StackPanel><TextBlock Text="PORT" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Udp.Port}" Style="{StaticResource ConfigTextBox}" /></StackPanel>
                        <StackPanel><TextBlock Text="TTL" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Udp.Ttl}" Style="{StaticResource ConfigTextBox}" /></StackPanel>
                        <StackPanel><TextBlock Text="BANDWIDTH (%)" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Udp.Bandwidth}" Style="{StaticResource ConfigTextBox}" /></StackPanel>
                        <CheckBox Content="RTP header" IsChecked="{Binding Udp.RtpHeader}" Style="{StaticResource ConfigCheckBox}" />
                        <CheckBox Content="Flow control" IsChecked="{Binding Udp.FlowControl}" Style="{StaticResource ConfigCheckBox}" />
                    </UniformGrid>
                </Expander>
                <Expander Margin="0,10,0,0">
                    <Expander.Header><TextBlock Text="RIST" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" /></Expander.Header>
                    <UniformGrid Columns="2" Margin="0,12,0,0">
                        <StackPanel><TextBlock Text="IP ADDRESS" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Rist.IpAddress}" Style="{StaticResource ConfigTextBox}" /></StackPanel>
                        <StackPanel><TextBlock Text="PORT" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Rist.Port}" Style="{StaticResource ConfigTextBox}" /></StackPanel>
                    </UniformGrid>
                </Expander>
                <Expander Margin="0,10,0,0">
                    <Expander.Header><TextBlock Text="Push output" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" /></Expander.Header>
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="DESTINATION URL" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Push.Url}" Style="{StaticResource ConfigTextBox}" />
                        <UniformGrid Columns="3">
                            <StackPanel><TextBlock Text="FORMAT" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding Push.Formats}" SelectedItem="{Binding Push.Format}" Style="{StaticResource ConfigComboBox}" /></StackPanel>
                            <StackPanel><TextBlock Text="HEVC ID" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Push.HevcId}" Style="{StaticResource ConfigTextBox}" /></StackPanel>
                            <StackPanel><TextBlock Text="COMPATIBILITY" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding Push.CompatibilityModes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Push.Compatibility}" Style="{StaticResource ConfigComboBox}" /></StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="{Binding Name}" FontSize="25" FontWeight="SemiBold" /><TextBlock Text="{Binding SourceType}" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" /></StackPanel>
            <Border Grid.Column="1" Background="#27313D" CornerRadius="12" Padding="10,5" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" VerticalAlignment="Center" /><TextBlock Text="{Binding Status}" Margin="7,0,0,0" FontWeight="SemiBold" /></StackPanel></Border>
        </Grid>
        <Border Grid.Row="1" Background="#241F12" BorderBrush="#5B4818" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,18,0,14">
            <TextBlock Text="Preview mode: controls are interactive, but changes remain only in this window. Save is disabled and no update RPC is sent to the device." Foreground="#FFD978" TextWrapping="Wrap" />
        </Border>

        <TabControl Grid.Row="2">
            <TabControl.Style>
                <Style TargetType="TabControl" BasedOn="{StaticResource {x:Type TabControl}}">
                    <Setter Property="SelectedIndex" Value="0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Configuration.Decode.IsNetworkSource}" Value="False">
                            <Setter Property="SelectedIndex" Value="1" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TabControl.Style>
            <TabItem Header="Decode">
                <TabItem.Style>
                    <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Configuration.Decode.IsNetworkSource}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TabItem.Style>
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="6,4,6,20">
                    <Border Style="{StaticResource ConfigCard}" IsEnabled="{Binding Configuration.Decode.IsNetworkSource}"><StackPanel>
                        <TextBlock Text="Network input" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="Only applies to Network decoder channels." Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,3,0,14" />
                        <TextBlock Text="STREAM URL" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Configuration.Decode.SourceUrl}" Style="{StaticResource ConfigTextBox}" />
                        <UniformGrid Columns="2">
                            <StackPanel><TextBlock Text="INPUT FRAMERATE (-1 = SOURCE)" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding Configuration.Decode.Framerates}" IsEditable="True" Text="{Binding Configuration.Decode.InputFramerate}" Style="{StaticResource ConfigComboBox}" /></StackPanel>
                            <StackPanel><TextBlock Text="TRANSPORT PROTOCOL" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding Configuration.Decode.Protocols}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Configuration.Decode.Protocol}" Style="{StaticResource ConfigComboBox}" /></StackPanel>
                            <StackPanel><TextBlock Text="BUFFER MODE" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding Configuration.Decode.BufferModes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Configuration.Decode.BufferMode}" Style="{StaticResource ConfigComboBox}" /></StackPanel>
                            <StackPanel><TextBlock Text="MINIMUM DELAY (MS)" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Configuration.Decode.MinimumDelay}" Style="{StaticResource ConfigTextBox}" /></StackPanel>
                        </UniformGrid>
                        <WrapPanel><CheckBox Content="Video decode" IsChecked="{Binding Configuration.Decode.DecodeVideo}" Style="{StaticResource ConfigCheckBox}" /><CheckBox Content="Audio decode" IsChecked="{Binding Configuration.Decode.DecodeAudio}" Style="{StaticResource ConfigCheckBox}" /><CheckBox Content="Channel enabled" IsChecked="{Binding Configuration.MainEncoder.Enabled}" Style="{StaticResource ConfigCheckBox}" /></WrapPanel>
                    </StackPanel></Border>
                    <Border Style="{StaticResource ConfigCard}"><StackPanel>
                        <TextBlock Text="Picture transform" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14" />
                        <UniformGrid Columns="3">
                            <StackPanel><TextBlock Text="ROTATE" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding Configuration.Decode.Rotations}" SelectedItem="{Binding Configuration.Decode.Rotate}" Style="{StaticResource ConfigComboBox}" /></StackPanel>
                            <StackPanel><TextBlock Text="CONTRAST" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Configuration.Decode.Contrast}" Style="{StaticResource ConfigTextBox}" /></StackPanel>
                            <CheckBox Content="Deinterlace" IsChecked="{Binding Configuration.Decode.Deinterlace}" Style="{StaticResource ConfigCheckBox}" />
                            <StackPanel><TextBlock Text="CROP LEFT (PX)" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Configuration.Decode.CropLeft}" Style="{StaticResource ConfigTextBox}" /></StackPanel>
                            <StackPanel><TextBlock Text="CROP TOP (PX)" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Configuration.Decode.CropTop}" Style="{StaticResource ConfigTextBox}" /></StackPanel>
                            <StackPanel><TextBlock Text="CROP RIGHT (PX)" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Configuration.Decode.CropRight}" Style="{StaticResource ConfigTextBox}" /></StackPanel>
                            <StackPanel><TextBlock Text="CROP BOTTOM (PX)" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Configuration.Decode.CropBottom}" Style="{StaticResource ConfigTextBox}" /></StackPanel>
                        </UniformGrid>
                    </StackPanel></Border>
                </StackPanel></ScrollViewer>
            </TabItem>

            <TabItem Header="Encode">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="6,4,6,20">
                    <TabControl>
                        <TabItem Header="Main stream"><Border Style="{StaticResource ConfigCard}"><ContentControl Content="{Binding Configuration.MainEncoder}" ContentTemplate="{StaticResource EncoderTemplate}" /></Border></TabItem>
                        <TabItem Header="Sub stream"><Border Style="{StaticResource ConfigCard}"><ContentControl Content="{Binding Configuration.SubEncoder}" ContentTemplate="{StaticResource EncoderTemplate}" /></Border></TabItem>
                    </TabControl>
                    <Border Style="{StaticResource ConfigCard}"><StackPanel>
                        <TextBlock Text="Audio encoder" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="One audio encoder is shared by the main and sub streams." Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,3,0,14" />
                        <UniformGrid Columns="3">
                            <StackPanel><TextBlock Text="CODEC" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding Configuration.Audio.Codecs}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Configuration.Audio.Codec}" Style="{StaticResource ConfigComboBox}" /></StackPanel>
                            <StackPanel><TextBlock Text="SOURCE" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding Configuration.Audio.Sources}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Configuration.Audio.Source}" Style="{StaticResource ConfigComboBox}" /></StackPanel>
                            <StackPanel><TextBlock Text="GAIN" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding Configuration.Audio.Gains}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Configuration.Audio.Gain}" Style="{StaticResource ConfigComboBox}" /></StackPanel>
                            <StackPanel><TextBlock Text="SAMPLE RATE" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding Configuration.Audio.SampleRates}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Configuration.Audio.SampleRate}" Style="{StaticResource ConfigComboBox}" /></StackPanel>
                            <StackPanel><TextBlock Text="CHANNELS" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding Configuration.Audio.ChannelModes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Configuration.Audio.Channels}" Style="{StaticResource ConfigComboBox}" /></StackPanel>
                            <StackPanel><TextBlock Text="BITRATE (KB/S)" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding Configuration.Audio.Bitrates}" IsEditable="True" Text="{Binding Configuration.Audio.Bitrate}" Style="{StaticResource ConfigComboBox}" /></StackPanel>
                        </UniformGrid>
                    </StackPanel></Border>
                </StackPanel></ScrollViewer>
            </TabItem>

            <TabItem Header="Stream">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="6,4,6,20">
                    <TabControl>
                        <TabItem Header="Main stream"><Border Style="{StaticResource ConfigCard}"><ContentControl Content="{Binding Configuration.MainStream}" ContentTemplate="{StaticResource StreamOutputTemplate}" /></Border></TabItem>
                        <TabItem Header="Sub stream"><Border Style="{StaticResource ConfigCard}"><ContentControl Content="{Binding Configuration.SubStream}" ContentTemplate="{StaticResource StreamOutputTemplate}" /></Border></TabItem>
                    </TabControl>
                    <Border Style="{StaticResource ConfigCard}"><StackPanel>
                        <TextBlock Text="Shared output settings" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <Expander><Expander.Header><TextBlock Text="MPEG-TS transport" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" /></Expander.Header><UniformGrid Columns="3" Margin="0,12,0,0">
                            <StackPanel><TextBlock Text="PACKET SIZE" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding Configuration.Transport.PacketSizes}" IsEditable="True" Text="{Binding Configuration.Transport.PacketSize}" Style="{StaticResource ConfigComboBox}" /></StackPanel>
                            <StackPanel><TextBlock Text="PID" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Configuration.Transport.Pid}" Style="{StaticResource ConfigTextBox}" /></StackPanel>
                            <StackPanel><TextBlock Text="PMT PID" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Configuration.Transport.PmtPid}" Style="{StaticResource ConfigTextBox}" /></StackPanel>
                            <StackPanel><TextBlock Text="SERVICE ID" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Configuration.Transport.ServiceId}" Style="{StaticResource ConfigTextBox}" /></StackPanel>
                            <StackPanel><TextBlock Text="STREAM ID" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Configuration.Transport.StreamId}" Style="{StaticResource ConfigTextBox}" /></StackPanel>
                            <StackPanel><TextBlock Text="NETWORK ID" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Configuration.Transport.NetworkId}" Style="{StaticResource ConfigTextBox}" /></StackPanel>
                        </UniformGrid></Expander>
                        <Expander Margin="0,10,0,0"><Expander.Header><TextBlock Text="HLS segmentation" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" /></Expander.Header><UniformGrid Columns="2" Margin="0,12,0,0">
                            <StackPanel><TextBlock Text="SEGMENT LENGTH (S)" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Configuration.Hls.SegmentLength}" Style="{StaticResource ConfigTextBox}" /></StackPanel>
                            <StackPanel><TextBlock Text="LIST LENGTH" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Configuration.Hls.ListLength}" Style="{StaticResource ConfigTextBox}" /></StackPanel>
                            <StackPanel><TextBlock Text="BASE URL" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Configuration.Hls.BaseUrl}" Style="{StaticResource ConfigTextBox}" /></StackPanel>
                            <StackPanel><TextBlock Text="FILENAME FORMAT" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Configuration.Hls.Filename}" Style="{StaticResource ConfigTextBox}" /></StackPanel>
                        </UniformGrid></Expander>
                        <Expander Margin="0,10,0,0"><Expander.Header><TextBlock Text="NDI output" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" /></Expander.Header><UniformGrid Columns="2" Margin="0,12,0,0">
                            <StackPanel><TextBlock Text="NDI NAME" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Configuration.Ndi.Name}" Style="{StaticResource ConfigTextBox}" /></StackPanel>
                            <StackPanel><TextBlock Text="NDI GROUP" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Configuration.Ndi.Group}" Style="{StaticResource ConfigTextBox}" /></StackPanel>
                            <CheckBox Content="NDI enabled" IsChecked="{Binding Configuration.Ndi.Enabled}" Style="{StaticResource ConfigCheckBox}" />
                        </UniformGrid></Expander>
                    </StackPanel></Border>
                </StackPanel></ScrollViewer>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="3" Margin="0,18,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Button Grid.Column="1" Content="Save changes" IsEnabled="False" ToolTip="Saving configuration is not implemented yet." />
            <Button Grid.Column="3" Content="Close" Style="{StaticResource PrimaryButton}" Click="CloseButton_Click" />
        </Grid>
    </Grid>
</UserControl>
